# Required: LLM inference (Groq)
GROQ_API_KEY=your_groq_api_key_here

# Required: Evaluation (LLM-as-judge)
OPENAI_API_KEY=your_openai_api_key_here

# Optional: LLMOps (Opik/Comet for evaluation tracking, prompt versioning)
# COMET_API_KEY=
# COMET_WORKSPACE=your-workspace-name
# COMET_PROJECT=philoagents

# Optional: Override defaults
# GROQ_LLM_MODEL=llama-3.3-70b-versatile
# GROQ_LLM_MODEL_CONTEXT_SUMMARY=llama-3.1-8b-instant

# MongoDB: Auto-configured for Docker. Override only if running outside Docker.
# MONGODB_URI=mongodb://philoagents:philoagents@localhost:27017/?directConnection=true
